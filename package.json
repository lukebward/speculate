{
  "name": "speculate",
  "version": "1.0.0",
  "private": true,
  "description": "Claude Code mod that learns your MCP call patterns and prefetches likely read-only calls",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:mod": "claude plugin test .",
    "validate": "claude plugin validate .",
    "typecheck": "tsc -p tsconfig.core.json && tsc",
    "eval": "tsx eval/eval.ts",
    "mock-github": "tsx mock/mock-github.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukebward/speculate.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-mod",
    "mcp",
    "model-context-protocol",
    "prefetch",
    "speculative-execution",
    "latency"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lukebward/speculate/issues"
  },
  "homepage": "https://github.com/lukebward/speculate#readme",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.6.5",
    "@types/ws": "8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
