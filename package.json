{
  "name": "speculate-mcp",
  "version": "0.20.0",
  "description": "Local learning MCP proxy that prefetches read-only tool calls to reduce waiting",
  "main": "dist/src/cli.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "vitest run",
    "test:scenarios": "vitest run test/scenarios.test.ts",
    "bench": "tsx bench/repeated.ts",
    "bench:remote": "tsx bench/remote.ts",
    "bench:repeated": "tsx bench/repeated.ts",
    "eval": "tsx eval/eval.ts",
    "demo": "tsx demo/demo.ts",
    "mock-github": "tsx mock/mock-github.ts",
    "start": "tsx src/cli.ts",
    "prepare": "node scripts/prepare.cjs",
    "prepublishOnly": "npm run build && npm test",
    "demo:gif": "node scripts/demo-gif.mjs",
    "bench:mock": "tsx bench/bench.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukebward/speculate.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prefetch",
    "speculative-execution",
    "latency",
    "claude-code",
    "proxy",
    "ai-agents"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/lukebward/speculate/issues"
  },
  "homepage": "https://github.com/lukebward/speculate#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "bin": {
    "speculate": "dist/src/cli.js",
    "speculate-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "plugin",
    ".claude-plugin",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
