{
  "name": "speculate-mcp",
  "version": "1.0.0",
  "description": "Speculate for Claude Code: a mod that learns your MCP call patterns and prefetches likely read-only calls",
  "type": "module",
  "bin": {
    "speculate": "dist/src/cli.js",
    "speculate-mcp": "dist/src/cli.js"
  },
  "files": [
    ".claude-plugin",
    "hooks",
    "src",
    "dist/src/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:mod": "claude plugin test .",
    "validate": "claude plugin validate .",
    "typecheck": "tsc -p tsconfig.core.json && tsc",
    "eval": "tsx eval/eval.ts",
    "mock-github": "tsx mock/mock-github.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukebward/speculate.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-mod",
    "mcp",
    "model-context-protocol",
    "prefetch",
    "speculative-execution",
    "latency"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/lukebward/speculate/issues"
  },
  "homepage": "https://github.com/lukebward/speculate#readme",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.1.1",
    "@types/ws": "8.18.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
